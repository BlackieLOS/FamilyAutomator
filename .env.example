# Local dev default; point at a hosted Postgres before deploying to
# production (Vercel's serverless filesystem is ephemeral/read-only).
DATABASE_URL="file:./prisma/dev.db"

# Stripe (test-mode keys for local dev — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# for local testing, or from the webhook endpoint you configure in the
# Stripe Dashboard once this is deployed.
STRIPE_WEBHOOK_SECRET="whsec_..."
